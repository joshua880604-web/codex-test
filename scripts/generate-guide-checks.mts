import fs from 'node:fs/promises';import {calculators,defaults,runCalculation} from '../src/lib/calculators';
const base=(id:string,mode:string)=>defaults(calculators.find(c=>c.id===id)!.modes.find(m=>m.id===mode)!);
const val=(r:ReturnType<typeof runCalculation>,label:string)=>r.metrics.find(m=>m.label===label)!.value;
const debts='Small balance,1000,50,6\nHigh APR,5000,150,24\nMid balance,2500,75,12';
const debt=[];for(const budget of [300,400,500,600,700])for(const strategy of ['snowball','avalanche']){const values={...base('debt-payoff',strategy),debts,extra:String(budget-275),rollover:'Yes',yearly:'0',once:'0',once_month:'1'},r=runCalculation('debt-payoff',strategy,values);const first=r.rows!.find(row=>row.slice(4).some(v=>Number(v)<=1e-7))!;debt.push({budget,strategy,values,months:val(r,'Months until debt-free'),firstMonth:Number(first[0]),interest:val(r,'Total interest'),paid:val(r,'Total paid')});}
const biweekly=[];for(const rate of [0,2,4,6,8]){const values={...base('biweekly-mortgage','biweekly'),principal:'300000',years:'30',months:'0',rate:String(rate),extra:'0'},r=runCalculation('biweekly-mortgage','biweekly',values);biweekly.push({rate,values,monthly:val(r,'Standard monthly payment'),half:val(r,'Biweekly payment'),matchedPayment:val(r,'Monthly payment with the same annual budget'),annualBudget:val(r,'Annual biweekly payment budget'),standardInterest:val(r,'Standard monthly total interest'),biweeklyInterest:val(r,'Biweekly total interest'),matchedInterest:val(r,'Matched-budget monthly total interest'),biweeklyYears:val(r,'Years to payoff with biweekly payments'),matchedYears:val(r,'Matched-budget monthly payoff years')});}
const points=[];for(const feeB of [3000,4000])for(const hold of [0,12,24,36,48,60]){const values={...base('discount-points','compare'),principal:'400000',years:'30',rate_a:'6.75',points_a:'0',rate_b:'6.375',points_b:'1',hold:String(hold),fees_a:'3000',fees_b:String(feeB)},r=runCalculation('discount-points','compare',values);points.push({feeB,hold,values,upfront:val(r,'Additional upfront cost for B'),cashSaving:val(r,'Net cash-flow savings at horizon'),balanceAdvantage:val(r,'Balance advantage of B at horizon'),netSaving:val(r,'Net borrowing-cost savings at horizon (B vs A)'),costBreak:val(r,'First net-cost break-even month'),cashBreak:val(r,'First cash-flow break-even month')});}
const data={checkedOn:'2026-10-30',kind:'Hypothetical controlled model cases, not observed borrower data',debt,biweekly,points};await fs.writeFile('src/lib/guide-check-data.json',JSON.stringify(data,null,2)+'\n');
async function csv(name:string,columns:string[],rows:(string|number)[][]){await fs.writeFile('public/data/'+name+'.csv','\uFEFF'+[['Checked on','Data type',...columns],...rows.map(row=>['2026-10-30','Hypothetical model scenario; not observed data',...row])].map(row=>row.map(v=>'"'+String(v).replaceAll('"','""')+'"').join(',')).join('\r\n')+'\r\n');}
await csv('debt-strategy-budget-check',['Monthly total budget USD','Strategy','First payoff month','Debt-free month','Total interest USD','Total paid USD'],debt.map(r=>[r.budget,r.strategy,r.firstMonth,r.months,r.interest,r.paid]));
await csv('biweekly-matched-budget-check',['Annual nominal rate percent','Standard monthly payment USD','Biweekly payment USD','Matched monthly payment USD','Matched annual planned budget USD','Standard monthly interest USD','Biweekly interest USD','Matched monthly interest USD','Biweekly modeled years','Matched monthly modeled years'],biweekly.map(r=>[r.rate,r.monthly,r.half,r.matchedPayment,r.annualBudget,r.standardInterest,r.biweeklyInterest,r.matchedInterest,r.biweeklyYears,r.matchedYears]));
await csv('mortgage-points-horizon-check',['Other upfront fees B USD','Holding months','Extra upfront cost B USD','Net cash-flow saving B USD','Balance advantage B USD','Net borrowing-cost saving B USD','Cost break-even month','Cash-flow break-even month'],points.map(r=>[r.feeB,r.hold,r.upfront,r.cashSaving,r.balanceAdvantage,r.netSaving,r.costBreak,r.cashBreak]));
console.log('Generated10debt+5biweekly+12points=27cases,37planoutcomes,3CSVs.');
