import fs from 'node:fs/promises';
import {calculators,defaults,runCalculation} from '../src/lib/calculators';
const entries:any[]=[];
function series(id:string,slug:string,tool:string,mode:string,axis:string,grid:number[],fixed:Record<string,string>,fields:string[],axisLabel:string,seriesLabels:string[],select?:(r:any,v:any)=>number[]){
 const m=calculators.find(c=>c.id===tool)!.modes.find(m=>m.id===mode)!;
 const rows=grid.map(x=>{const values={...defaults(m),...fixed,[axis]:String(x)};const r=runCalculation(tool,mode,values);if(r.error)throw Error(r.error);return {x,values,outputs:select?select(r,values):fields.map(label=>{const n=r.metrics.find((m:any)=>m.label===label)?.value;if(!Number.isFinite(n))throw Error(id+': '+label);return n;})};});
 entries.push({id,slug,tool,mode,axis,axisLabel,seriesLabels,rows});
}
series('recast','mortgage-recast-vs-refinance','mortgage-recast','compare','lump',[10000,20000,30000,40000,50000],{principal:'300000',rate:'6',years:'25',months:'0',fee:'300',current_payment:''},['Recast remaining interest','Lump-sum-only remaining interest'],'Principal paid now (USD)',['Recast: future interest','Keep payment: future interest']);
series('cd','cd-vs-savings-account','cd','accumulation','rate',[2,3,4,5,6],{principal:'10000',rate_type:'APY',years:'1',months:'0',tax:'0',compound:'Monthly'},['Maturity balance'],'Constant APY assumption (%)',['One-year balance']);
series('car','pay-off-car-loan-early','repayment','extra-payments','extra_monthly',[0,50,100,150,200],{principal:'20000',rate:'6',payment:'400',extra_yearly:'0',extra_once:'0',extra_once_month:'1'},['Total interest'],'Extra monthly principal budget (USD)',['Future interest']);
series('emergency','how-much-emergency-fund-should-i-have','emergency-fund','plan','months',[3,4,5,6,7],{expenses:'3200',savings:'4000',deposit:'500'},['Emergency fund target','Remaining savings gap'],'Essential-expense coverage (months)',['Reserve target','Unfunded gap']);
series('rent','rent-vs-buy-a-house','rent-vs-buy','comparison','appreciation',[0,1,2,3,4],{price:'400000',down:'20',rate:'6',years:'30',buy_closing:'3',selling:'6',tax:'4800',insurance:'1500',hoa:'0',maintenance:'4000',cost_growth:'0',tax_growth:'0',rent:'2200',rent_growth:'0',renter_insurance:'200',deposit:'2200',rental_costs:'0',return:'0',tax_rate:'0',standard:'16100'},[],'Annual home appreciation assumption (%)',['Buyer sale equity at year 5','Renter wealth at year 5'],r=>r.rows[4].slice(1,3).map(Number));
series('debt-save','should-i-pay-off-debt-or-save','repayment','extra-payments','extra_monthly',[0,50,100,150,200],{principal:'6000',rate:'18',payment:'200',extra_yearly:'0',extra_once:'0',extra_once_month:'1'},['Total interest'],'Of $200 spare monthly cash, allocated to extra debt (USD)',['Future debt interest']);
series('apr','apr-vs-interest-rate','apr','loan','upfront',[0,200,400,600,800],{principal:'20000',years:'5',months:'0',rate:'6',compound:'Monthly',pay:'Monthly',financed:'0'},['Total borrowing cost over full term'],'Cash-paid upfront fees (USD)',['Full-term borrowing cost']);
series('refinance','is-refinancing-worth-it','refinance','balance','new_years',[10,15,20,25,30],{principal:'250000',payment:'1800',rate:'6',new_rate:'5',cashout:'0',points:'0',fees:'3000',finance:'No'},['New total interest'],'New amortization term (years)',['New interest plus $3,000 fee'],r=>[r.metrics.find((m:any)=>m.label==='New total interest').value+3000]);
series('ira','roth-ira-vs-traditional-ira','ira','comparison','retire_tax',[0,10,20,30,40],{age:'35',retire:'65',balance:'0',contribution:'6000',max:'No',return:'6',tax:'20'},['Traditional IRA after-tax value','Roth balance with equivalent after-tax contribution'],'Retirement tax assumption (%)',['Traditional: after-tax value','Roth: equal-budget value']);
series('margin','margin-vs-markup','markup','price','markup',[0,25,50,75,100],{cost:'100'},['Selling price','Gross profit per unit'],'Markup on cost (%)',['Selling price','Gross profit per unit']);
series('coast','how-to-calculate-coast-fire','coast-fire','coast','retire',[55,60,65,70,75],{household:'Individual',age:'35',balance:'150000',partner_balance:'0',spending:'40000',return:'7',inflation:'2.5',withdrawal:'4',monthly:'1000',partner_monthly:'0'},['Coast FIRE number today'],'Full-retirement target age',['Required portfolio today']);
for(const strategy of ['snowball','avalanche'])series(strategy,'how-to-calculate-debt-'+strategy,'debt-'+strategy,strategy,'once_month',[1,4,7,10,13],{debts:'Card A, 5000, 150, 22\nCard B, 3000, 100, 18',budget:'400',rollover:'Yes',once:'1000'},['Total interest'],'Month a $1,000 extra payment is credited',['Total modeled interest']);
series('barista','barista-fire-vs-coast-fire','barista-fire','plan','income_end',[45,50,55,60,65],{age:'45',start_age:'45',retire_age:'65',balance:'760000',monthly:'0',spending:'36000',income:'24000',full_spending:'24000',return:'0',inflation:'0',withdrawal:'4'},['Required portfolio at part-time start'],'Part-time earnings stop at age',['Required assets at age 45']);
await fs.writeFile('src/lib/remaining-guide-data.json',JSON.stringify(entries,null,2)+'\n');
for(const e of entries){const esc=(x:any)=>'"'+String(x).replaceAll('"','""')+'"';const rows=[['Checked on','Data kind',e.axisLabel,...e.seriesLabels,'Inputs JSON'],...e.rows.map((r:any)=>['2026-10-30','Hypothetical deterministic model case; not observed data',r.x,...r.outputs,JSON.stringify(r.values)])];await fs.writeFile('public/data/guide-'+e.id+'-check.csv','\uFEFF'+rows.map(r=>r.map(esc).join(',')).join('\r\n')+'\r\n');}
console.log(JSON.stringify({guides:entries.length,cases:entries.reduce((n,e)=>n+e.rows.length,0),files:'14 CSV + 1 JSON'}));
