{
  "name": "financial-calculators",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-env-proxy node_modules/next/dist/bin/next dev --hostname 0.0.0.0",
    "build": "next build && node --import tsx scripts/build-embeds.mts && node scripts/finalize-static.mjs",
    "start": "node scripts/serve-static.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "preview": "node scripts/serve-static.mjs"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "tsx": "latest"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
