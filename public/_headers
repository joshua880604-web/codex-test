# Next.js content-hashed assets change URL whenever their content changes.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed local Inter variable font.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Public widgets intentionally allow every parent, including opaque file:// origins.
# Do not add frame-ancestors *: it rejects local-file/non-network parents.
# Keep widget resource/connection restrictions; normal page policies are untouched.
/embed/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'none'; img-src 'self' data:; base-uri 'none'; form-action 'none'
  X-Robots-Tag: noindex

/embed/assets/*
  Cache-Control: public, max-age=31536000, immutable
