# Next.js content-hashed assets change URL whenever their content changes.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed local Inter variable font.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Standalone widgets may be framed; they cannot fetch ads or send calculator inputs.
/embed/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'none'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors *
  X-Robots-Tag: noindex

/embed/assets/*
  Cache-Control: public, max-age=31536000, immutable
